{{define "home"}}
{{template "base_start" .}}
  <div class="flex flex-col lg:flex-row gap-6">
    <div class="flex-1 space-y-4">
      <h1 class="text-3xl font-semibold">Toutes les recettes</h1>
      <p class="text-zinc-600 dark:text-zinc-300">Résultats filtrés directement depuis <strong>hfresh.info</strong>. Utilisez la recherche et les filtres pour retrouver rapidement une recette.</p>
    </div>
    <div class="lg:w-80">
      <form method="POST" action="/refresh" class="lg:hidden">
        <button type="submit" class="btn-secondary w-full">Actualiser depuis hfresh.info</button>
      </form>
      {{if .Filters}}
      <div class="card mt-4 lg:mt-0">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold">Filtres</h2>
          <a class="text-sm text-lime-600 hover:underline" href="/">Réinitialiser</a>
        </div>
        <form method="GET" action="/">
          <div class="space-y-3 mt-4">
            <div>
              <label class="text-sm text-zinc-500 block mb-1">Recherche</label>
              <input type="text" name="q" value="{{index .Filters `Query`}}" placeholder="Nom, ingrédient, tag..." class="field w-full">
            </div>
            <div>
              <label class="text-sm text-zinc-500 block mb-1">Difficulté</label>
              <select name="difficulty" class="field w-full">
                <option value="">Toutes</option>
                {{range $diff := index .Available `Difficulty`}}
                  <option value="{{$diff}}" {{if eq (index $.Filters `Difficulty`) $diff}}selected{{end}}>{{$diff}}</option>
                {{end}}
              </select>
            </div>
            <div>
              <label class="text-sm text-zinc-500 block mb-1">Cuisine</label>
              <select name="cuisine" class="field w-full">
                <option value="">Toutes</option>
                {{range $c := index .Available `Cuisine`}}
                  <option value="{{$c}}" {{if eq (index $.Filters `Cuisine`) $c}}selected{{end}}>{{$c}}</option>
                {{end}}
              </select>
            </div>
            <div>
              <p class="text-sm text-zinc-500 mb-1">Tags</p>
              <div class="flex flex-wrap gap-2">
                {{range $tag := index .Available `Tags`}}
                  <label class="badge-toggle">
                    <input type="checkbox" name="tag" value="{{$tag}}" {{if hasTag (index $.Filters `Tags`) $tag}}checked{{end}}>
                    <span>{{$tag}}</span>
                  </label>
                {{end}}
              </div>
            </div>
            <button type="submit" class="btn-primary w-full">Filtrer</button>
          </div>
        </form>
      </div>
      {{end}}
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
    {{range .Recipes}}
      <article class="card h-full flex flex-col">
        <div class="relative">
          {{if .Image}}<img src="{{.Image}}" alt="{{.Title}}" class="w-full aspect-video object-cover rounded-lg">{{end}}
          <div class="absolute top-2 right-2 flex gap-2">
            {{if .HelloFreshURL}}
            <a href="{{.HelloFreshURL}}" target="_blank" rel="noopener noreferrer" class="icon-btn" title="Voir sur HelloFresh">
              ↗
            </a>
            {{end}}
            <a href="{{.HfreshURL}}" class="icon-btn" title="Ouvrir sur hfresh.info">🌐</a>
          </div>
        </div>
        <div class="flex-1 flex flex-col gap-2 mt-3">
          <div class="flex items-start justify-between gap-3">
            <a href="/recipes/{{.Slug}}" class="text-lg font-semibold hover:underline">{{.Title}}</a>
            {{if .Difficulty}}<span class="badge neutral">{{.Difficulty}}</span>{{end}}
          </div>
          {{if .Tagline}}<p class="text-sm text-zinc-500 line-clamp-2">{{.Tagline}}</p>{{end}}
          <div class="flex items-center gap-3 text-sm text-zinc-600 dark:text-zinc-300">
            {{if .PrepTime}}<span>⏱️ {{.PrepTime}}</span>{{end}}
            {{if .Cuisine}}<span>🌍 {{.Cuisine}}</span>{{end}}
          </div>
          <div class="flex flex-wrap gap-1">
            {{range .Tags}}
              <span class="badge">{{.}}</span>
            {{end}}
          </div>
          <div class="mt-auto pt-3 flex items-center gap-2">
            <a href="/recipes/{{.Slug}}" class="btn-secondary w-1/2 text-center">Détails</a>
            <form method="POST" action="/shopping-list/add" class="flex items-center gap-2 w-1/2 justify-end">
              <input type="hidden" name="slug" value="{{.Slug}}">
              <input type="number" name="servings" min="1" value="2" class="field w-16" aria-label="Nombre de personnes">
              <button type="submit" class="btn-primary w-full">Ajouter</button>
            </form>
          </div>
        </div>
      </article>
    {{end}}
  </div>

  {{if not .Recipes}}
    <p class="text-center text-zinc-500">Aucune recette ne correspond aux filtres actuels.</p>
  {{end}}
{{template "base_end" .}}
{{end}}
