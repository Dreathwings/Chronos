{{define "base_start"}}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{if .PageTitle}}{{.PageTitle}} ·{{end}} Chronos · Recettes HelloFresh</title>
  <link rel="icon" type="image/png" href="https://hfresh.info/assets/favicons/production.png">
  <link rel="stylesheet" href="https://hfresh.info/build/assets/app-7xktaUh7.css">
  <link rel="stylesheet" href="/static/styles.css">
</head>
<body class="min-h-screen bg-white dark:bg-zinc-800 text-zinc-800 dark:text-white">
  <header class="z-10 min-h-14 flex items-center px-6 lg:px-8 bg-zinc-50 dark:bg-zinc-900 border-b border-zinc-200 dark:border-zinc-700 sticky top-0">
    <a href="/" class="h-10 flex items-center me-6 gap-2 font-semibold">
      <div class="flex items-center justify-center h-9 w-9 rounded-full bg-lime-500 text-white">
        <span>HF</span>
      </div>
      <span class="text-lg">Recettes HelloFresh</span>
    </a>
    <nav class="flex items-center gap-2">
      <a class="nav-link {{if eq .PageTitle `Recettes`}}active{{end}}" href="/">Recettes</a>
      <a class="nav-link {{if contains .PageTitle `Menu`}}active{{end}}" href="/menus">Menu de la semaine</a>
      <a class="nav-link {{if eq .PageTitle `Liste de courses`}}active{{end}}" href="/shopping-list">Liste de courses</a>
    </nav>
    <div class="ms-auto flex items-center gap-2">
      {{if not (isZeroTime .LastUpdated)}}
        <span class="text-sm text-zinc-500 dark:text-zinc-400 hidden sm:inline">Maj: {{.LastUpdated.Format "02/01/2006 15:04"}}</span>
      {{end}}
      <form method="POST" action="/refresh" class="hidden md:block">
        <button type="submit" class="btn-secondary">Actualiser depuis hfresh.info</button>
      </form>
    </div>
  </header>

  <main class="p-6 lg:p-8 max-w-7xl mx-auto space-y-8">
{{end}}

{{define "base_end"}}
  </main>
</body>
</html>
{{end}}
